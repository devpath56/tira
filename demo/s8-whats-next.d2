caption: {
  shape: text
  near: top-center
  style.font-size: 26
  label: "S8 · What's Next"
}

dashboard: {
  label: "Dashboard · unfinished"
  metrics_card: {
    label: "metrics card · drained"
    style.stroke: "#059669"
    style.stroke-width: 3
    fetch_metrics: {
      label: "fetch metrics\ndone"
      style.fill: "#d1fae5"
      style.stroke: "#059669"
    }
    improve_visual: {
      label: "improve visual · drained"
      colors: {
        label: "colors\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      design_tokens: {
        label: "design tokens\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      loading_state: {
        label: "loading state\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      font_task: {
        label: "font\ncancelled"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
        style.italic: true
      }
    }
  }
  table: {
    label: "Table\nunstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#c81e1e"
    style.stroke-width: 5
    pagination: {
      label: "pagination\nunstarted"
      style.fill: "#f3f4f6"
      style.stroke: "#9ca3af"
    }
  }
  filters: {
    label: "Filters · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
}

steps: {
  1: {
    caption.label: "A completion just landed. The system suggests — with receipts:"
  }
  2: {
    caption.label: "SUGGEST · START pagination\nRule: depth-first — first unstarted child of Table.\nRejected: Filters (deeper — finish this subtree first).\nVapor caveat: 0 open ideas in scope."
    dashboard.table.pagination.style.stroke: "#c81e1e"
    dashboard.table.pagination.style.stroke-dash: 6
    dashboard.table.pagination.style.stroke-width: 4
  }
  3: {
    caption.label: "Advisory only. Nothing moves until you say go."
    dashboard.table.pagination.style.stroke: "#9ca3af"
    dashboard.table.pagination.style.stroke-dash: null
    dashboard.table.pagination.style.stroke-width: 2
  }
}
