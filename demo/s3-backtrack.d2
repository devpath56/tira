caption: {
  shape: text
  near: top-center
  style.font-size: 26
  label: "S3 · The Backtrack"
}

dashboard: {
  label: "Dashboard · unfinished"
  metrics_card: {
    label: "metrics card · unfinished"
    fetch_metrics: {
      label: "fetch metrics\ndone"
      style.fill: "#d1fae5"
      style.stroke: "#059669"
    }
    improve_visual: {
      label: "improve visual · unfinished"
      colors: {
        label: "colors\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      design_tokens: {
        label: "design tokens\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      loading_state: {
        label: "loading state\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      font_task: {
        label: "font\ncancelled"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
        style.italic: true
      }
    }
  }
  table: {
    label: "Table · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
  filters: {
    label: "Filters · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
}

steps: {
  1: {
    caption.label: "improve_visual: done, done, done, cancelled -> subtree drained."
    dashboard.metrics_card.improve_visual.style.stroke: "#059669"
    dashboard.metrics_card.improve_visual.style.stroke-width: 3
  }
  2: {
    caption.label: "metrics_card: fetch_metrics done, improve_visual drained -> drained."
    dashboard.metrics_card.style.stroke: "#059669"
    dashboard.metrics_card.style.stroke-width: 3
  }
  3: {
    caption.label: "Dashboard: next unfinished child subtree -> Table.\nCursor derived by replay — never a stored flag."
    dashboard.table.label: "Table\nunstarted"
    dashboard.table.style.stroke: "#c81e1e"
    dashboard.table.style.stroke-width: 5
  }
}
