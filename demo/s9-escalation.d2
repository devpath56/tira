steps: {
  1: {
    caption.label: "Tuesday: \"We should offer CSV export.\"\nEVENT · DECLARE_VAPOR claim #8 (declarer: you)"
  }
  2: {
    caption.label: "The sweep drafts the file record.\nIt waits. Nobody has to remember it."
    claim_8.label: "claim #8: export CSV\nfile_pending · awaiting your approval"
    claim_8.style.fill: "#fef3c7"
    claim_8.style.stroke: "#d97706"
  }
  3: {
    caption.label: "3 days pass. No approval.\nDerived predicate: breached — the pipeline refuses to die quietly."
    claim_8.label: "claim #8: export CSV\nfile_pending · SLA breached (3 days)"
    claim_8.style.stroke: "#c81e1e"
    claim_8.style.stroke-dash: 6
  }
  4: {
    caption.label: "You approve late — 3 days later.\nEVENT · APPROVE_FILE claim #8 → filed. It survived in the log, not in memory."
    claim_8.label: "claim #8: export CSV\nfiled"
    claim_8.style.fill: "#dbeafe"
    claim_8.style.stroke: "#2563eb"
    claim_8.style.stroke-dash: null
  }
}
