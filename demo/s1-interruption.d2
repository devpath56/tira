caption: {
  shape: text
  near: top-center
  style.font-size: 26
  label: "S1 · The Interruption"
}

dashboard: {
  label: "Dashboard · unfinished"
  metrics_card: {
    label: "metrics card · unfinished"
    fetch_metrics: {
      label: "fetch metrics\ndone"
      style.fill: "#d1fae5"
      style.stroke: "#059669"
    }
    improve_visual: {
      label: "improve visual · unfinished"
      colors: {
        label: "colors\nin_progress"
        style.fill: "#fef3c7"
        style.stroke: "#c81e1e"
        style.stroke-width: 5
      }
      loading_state: {
        label: "loading state\nunstarted"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
      }
      font_task: {
        label: "font\nunstarted"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
      }
    }
  }
  table: {
    label: "Table · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
  filters: {
    label: "Filters · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
}

steps: {
  1: {
    caption.label: "Discovery: colors needs the design-token decision first.\nEVENT · BLOCK colors (blocker: design-tokens)"
    dashboard.metrics_card.improve_visual.colors.label: "colors\nblocked"
    dashboard.metrics_card.improve_visual.colors.style.fill: "#fee2e2"
    dashboard.metrics_card.improve_visual.colors.style.stroke: "#9ca3af"
    dashboard.metrics_card.improve_visual.colors.style.stroke-dash: 6
  }
  2: {
    caption.label: "The dependency becomes tracked work.\nEVENT · ADD_CHILD design_tokens (discovered_during: colors, tag: discovered)"
    dashboard.metrics_card.improve_visual.design_tokens: {
      label: "design tokens\nunstarted"
      style.fill: "#f3f4f6"
      style.stroke: "#9ca3af"
    }
  }
  3: {
    caption.label: "EVENT · START design_tokens — working the dependency now."
    dashboard.metrics_card.improve_visual.design_tokens.label: "design tokens\nin_progress"
    dashboard.metrics_card.improve_visual.design_tokens.style.fill: "#fef3c7"
    dashboard.metrics_card.improve_visual.design_tokens.style.stroke: "#c81e1e"
    dashboard.metrics_card.improve_visual.design_tokens.style.stroke-width: 5
  }
  4: {
    caption.label: "EVENT · COMPLETE design_tokens (evidence: token-spec.md)"
    dashboard.metrics_card.improve_visual.design_tokens.label: "design tokens\ndone"
    dashboard.metrics_card.improve_visual.design_tokens.style.fill: "#d1fae5"
    dashboard.metrics_card.improve_visual.design_tokens.style.stroke: "#059669"
    dashboard.metrics_card.improve_visual.design_tokens.style.stroke-width: 2
  }
  5: {
    caption.label: "EVENT · UNBLOCK colors — resume the original branch.\nReplay derives the cursor: colors. Nothing was lost."
    dashboard.metrics_card.improve_visual.colors.label: "colors\nin_progress"
    dashboard.metrics_card.improve_visual.colors.style.fill: "#fef3c7"
    dashboard.metrics_card.improve_visual.colors.style.stroke: "#c81e1e"
    dashboard.metrics_card.improve_visual.colors.style.stroke-width: 5
  }
  6: {
    caption.label: "EVENT · COMPLETE colors (evidence: palette.png)\nEvents, not states: BLOCK -> ADD_CHILD -> START -> COMPLETE -> UNBLOCK -> COMPLETE.\nStates folded from the log: in_progress -> blocked -> in_progress -> done."
    dashboard.metrics_card.improve_visual.colors.label: "colors\ndone"
    dashboard.metrics_card.improve_visual.colors.style.fill: "#d1fae5"
    dashboard.metrics_card.improve_visual.colors.style.stroke: "#059669"
    dashboard.metrics_card.improve_visual.colors.style.stroke-width: 2
  }
}
