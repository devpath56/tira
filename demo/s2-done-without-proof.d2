caption: {
  shape: text
  near: top-center
  style.font-size: 26
  label: "S2 · Done Without Proof"
}

dashboard: {
  label: "Dashboard · unfinished"
  metrics_card: {
    label: "metrics card · unfinished"
    fetch_metrics: {
      label: "fetch metrics\ndone"
      style.fill: "#d1fae5"
      style.stroke: "#059669"
    }
    improve_visual: {
      label: "improve visual · unfinished"
      colors: {
        label: "colors\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      design_tokens: {
        label: "design tokens\ndone"
        style.fill: "#d1fae5"
        style.stroke: "#059669"
      }
      loading_state: {
        label: "loading state\nin_progress"
        style.fill: "#fef3c7"
        style.stroke: "#c81e1e"
        style.stroke-width: 5
      }
      font_task: {
        label: "font\nunstarted"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
      }
    }
  }
  table: {
    label: "Table · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
  filters: {
    label: "Filters · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
}

steps: {
  1: {
    caption.label: "EVENT · COMPLETE loading_state (no evidence attached)\nX DENIED — evidenceRef required. The node stays in_progress."
    dashboard.metrics_card.improve_visual.loading_state.style.fill: "#fee2e2"
    dashboard.metrics_card.improve_visual.loading_state.style.stroke-dash: 6
  }
  2: {
    caption.label: "The guard holds. Now — with proof."
    dashboard.metrics_card.improve_visual.loading_state.style.fill: "#fef3c7"
    dashboard.metrics_card.improve_visual.loading_state.style.stroke: "#c81e1e"
    dashboard.metrics_card.improve_visual.loading_state.style.stroke-dash: null
    dashboard.metrics_card.improve_visual.loading_state.style.stroke-width: 5
  }
  3: {
    caption.label: "EVENT · COMPLETE loading_state (evidence: spinner.mp4)\nDone is a verdict, not a claim."
    dashboard.metrics_card.improve_visual.loading_state.label: "loading state\ndone"
    dashboard.metrics_card.improve_visual.loading_state.style.fill: "#d1fae5"
    dashboard.metrics_card.improve_visual.loading_state.style.stroke: "#059669"
    dashboard.metrics_card.improve_visual.loading_state.style.stroke-width: 2
  }
}
