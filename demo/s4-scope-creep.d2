caption: {
  shape: text
  near: top-center
  style.font-size: 26
  label: "S4 · Scope Creep Denied (interlude)"
}

dashboard: {
  label: "Dashboard · unfinished"
  metrics_card: {
    label: "metrics card · unfinished"
    fetch_metrics: {
      label: "fetch metrics\ndone"
      style.fill: "#d1fae5"
      style.stroke: "#059669"
    }
    improve_visual: {
      label: "improve visual · unfinished"
      colors: {
        label: "colors\nunstarted"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
      }
      loading_state: {
        label: "loading state\nunstarted"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
      }
      font_task: {
        label: "font\nunstarted"
        style.fill: "#f3f4f6"
        style.stroke: "#9ca3af"
      }
    }
  }
  table: {
    label: "Table · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
  filters: {
    label: "Filters · unstarted"
    style.fill: "#f3f4f6"
    style.stroke: "#9ca3af"
  }
}

steps: {
  1: {
    caption.label: "EVENT · ADD_CHILD cache_metrics under fetch_metrics\nX DENIED — branch is done. Re-open first."
    dashboard.metrics_card.fetch_metrics.style.fill: "#fee2e2"
    dashboard.metrics_card.fetch_metrics.style.stroke: "#c81e1e"
    dashboard.metrics_card.fetch_metrics.style.stroke-dash: 6
    dashboard.metrics_card.fetch_metrics.style.stroke-width: 5
  }
  2: {
    caption.label: "EVENT · REOPEN fetch_metrics (reason: \"cache scope added\")"
    dashboard.metrics_card.fetch_metrics.label: "fetch metrics\nin_progress"
    dashboard.metrics_card.fetch_metrics.style.fill: "#fef3c7"
    dashboard.metrics_card.fetch_metrics.style.stroke: "#c81e1e"
    dashboard.metrics_card.fetch_metrics.style.stroke-dash: null
    dashboard.metrics_card.fetch_metrics.style.stroke-width: 5
  }
  3: {
    caption.label: "EVENT · ADD_CHILD cache_metrics.\nExplicit, reasoned, logged."
    dashboard.metrics_card.fetch_metrics.cache_metrics: {
      label: "cache metrics\nunstarted"
      style.fill: "#f3f4f6"
      style.stroke: "#9ca3af"
    }
  }
}
